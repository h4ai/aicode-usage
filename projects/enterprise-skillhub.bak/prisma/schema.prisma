// Enterprise SkillHub — Prisma Schema
// Source of truth: TECH-DESIGN.md (all Specs aligned per DEV-RECHECK)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============================================================
// Enums
// ============================================================

enum UserRole {
  ADMIN
  PUBLISHER
  REVIEWER
  USER
}

enum SkillCategory {
  GENERAL
  DEVELOPMENT
  DEVOPS
  DATA
  SECURITY
  OFFICE
  MULTIMEDIA
  SEARCH
  BROWSER
  COMMUNICATION
  CUSTOM
}

enum SkillVisibility {
  PUBLIC
  DEPARTMENT
  PRIVATE
}

enum ModerationStatus {
  ACTIVE
  HIDDEN
  REMOVED
}

enum ReviewStatus {
  PENDING_AUTO
  AUTO_REJECTED
  PENDING_MANUAL
  IN_REVIEW
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum SourceType {
  ZIP
  GIT
}

enum GitAuthType {
  SSH_KEY
  TOKEN
  BASIC
}

enum CredentialScope {
  PERSONAL
  NAMESPACE
  GLOBAL
}

enum NamespaceRole {
  ADMIN
  MEMBER
}

enum TemplateStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  DEPRECATED
}

// Sprint 8: Download tracking enums
enum ResourceType {
  SKILL
  TEMPLATE
}

enum DownloadSource {
  CLI
  WEB
  API
}

// ============================================================
// Models
// ============================================================

model User {
  id          String   @id @default(cuid())
  username    String   @unique // AD sAMAccountName
  displayName String
  email       String   @unique
  department  String?
  adGroups    Json?    // Synced AD group memberships
  role        UserRole @default(USER)
  isActive    Boolean  @default(true)
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  skills           Skill[]
  skillVersions    SkillVersion[]
  reviews          SkillReview[]   @relation("reviewer")
  submittedReviews SkillReview[]   @relation("submitter")
  comments         Comment[]
  stars            Star[]
  auditLogs        AuditLog[]

  // Sprint 6: Namespace + Template relations
  ownedNamespaces     Namespace[]        @relation("NamespaceOwner")
  namespaceMemberships NamespaceMember[]
  templates           Template[]         @relation("TemplateAuthor")

  // Sprint 7: Git credentials
  gitCredentials      GitCredential[]

  // Sprint 8: Download logs
  downloadLogs        DownloadLog[]

  @@index([department])
  @@index([role])
}

model Skill {
  id                 String           @id @default(cuid())
  name               String
  slug               String           @unique
  summary            String?
  category           SkillCategory    @default(GENERAL)
  visibility         SkillVisibility  @default(PUBLIC)
  moderationStatus   ModerationStatus @default(ACTIVE)
  ownerId            String
  owner              User             @relation(fields: [ownerId], references: [id])
  latestVersionId    String?
  publishedVersionId String?
  downloadCount      Int              @default(0)
  weeklyDownloads    Int              @default(0)
  installCount       Int              @default(0)
  starCount          Int              @default(0)
  badges             Json?
  tags               String[]         @default([])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relations
  versions SkillVersion[]
  reviews  SkillReview[]
  comments Comment[]
  stars    Star[]

  @@index([category])
  @@index([visibility])
  @@index([ownerId])
  @@index([moderationStatus])
  @@index([slug])
}

model SkillVersion {
  id            String                          @id @default(cuid())
  skillId       String
  skill         Skill                           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  version       String // SemVer string e.g. "1.2.3"
  major         Int
  minor         Int
  patch         Int
  changelog     String?
  readme        String? // Extracted from SKILL.md
  parsedMeta    Json? // Parsed metadata from skill package
  tag           String? // "latest", "stable"
  reviewStatus  ReviewStatus                    @default(PENDING_AUTO)
  embedding     Unsupported("vector(1024)")?
  createdById   String
  createdBy     User                            @relation(fields: [createdById], references: [id])
  softDeletedAt DateTime?
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt

  // Relations
  files   SkillFile[]
  reviews SkillReview[]

  @@unique([skillId, version])
  @@index([skillId])
  @@index([reviewStatus])
  @@index([createdById])
  @@index([major, minor, patch])
}

model SkillFile {
  id              String       @id @default(cuid())
  skillVersionId  String
  skillVersion    SkillVersion @relation(fields: [skillVersionId], references: [id], onDelete: Cascade)
  fileName        String
  filePath        String // Path in MinIO
  fileSize        Int
  mimeType        String?
  sha256          String
  createdAt       DateTime     @default(now())

  @@index([skillVersionId])
}

model SkillReview {
  id            String       @id @default(cuid())
  skillId       String
  skill         Skill        @relation(fields: [skillId], references: [id])
  versionId     String
  version       SkillVersion @relation(fields: [versionId], references: [id])
  submitterId   String
  submitter     User         @relation("submitter", fields: [submitterId], references: [id])
  reviewerId    String?
  reviewer      User?        @relation("reviewer", fields: [reviewerId], references: [id])
  status        ReviewStatus @default(PENDING_AUTO)
  decision      String? // APPROVE, REJECT, REVISION_REQUESTED
  comment       String?
  scanResult    Json? // Auto-scan output (autoScanDetail)
  autoScanPassed Boolean?
  reviewScore   Int? // 1-5
  policyId      String?
  policy        ReviewPolicy? @relation(fields: [policyId], references: [id])
  submittedAt   DateTime     @default(now())
  autoScannedAt DateTime?
  assignedAt    DateTime?
  reviewedAt    DateTime?
  approvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([skillId])
  @@index([versionId])
  @@index([reviewerId])
  @@index([status])
}

model ReviewPolicy {
  id                  String         @id @default(cuid())
  name                String         @unique
  category            SkillCategory?
  department          String?

  // Policy rules
  autoApprove         Boolean        @default(false)
  autoApproveMinScore Int            @default(90)
  requiredReviews     Int            @default(1)
  reviewerAdGroups    String[]       @default([])
  maxReviewDays       Int            @default(3)
  timeoutHours        Int            @default(72)

  // Auto-scan config
  blockOnSecurityFail Boolean        @default(true)
  blockOnLicenseFail  Boolean        @default(true)
  requiredFiles       String[]       @default(["SKILL.md"])

  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  reviews             SkillReview[]

  @@index([category, department])
}

model Star {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, skillId])
  @@index([skillId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id])
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([skillId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String // e.g. "LOGIN_SUCCESS", "LOGIN_FAILURE", "SKILL_CREATE"
  resource   String? // e.g. "skill:xxx", "user:xxx"
  detail     Json?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([userId])
  @@index([createdAt])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Sprint 6: Namespace + Template System
// ============================================================

model Namespace {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  ownerId     String
  owner       User     @relation("NamespaceOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     NamespaceMember[]
  templates   Template[]

  @@index([name])
}

model NamespaceMember {
  id          String        @id @default(cuid())
  namespaceId String
  userId      String
  role        NamespaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  namespace   Namespace @relation(fields: [namespaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([namespaceId, userId])
}

model Template {
  id              String   @id @default(cuid())
  namespaceId     String
  name            String
  description     String?
  authorId        String
  isPublic        Boolean  @default(true)
  tags            String[] @default([])
  downloadCount   Int      @default(0)
  weeklyDownloads Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  namespace   Namespace @relation(fields: [namespaceId], references: [id])
  author      User      @relation("TemplateAuthor", fields: [authorId], references: [id])
  versions    TemplateVersion[]

  @@unique([namespaceId, name])
  @@index([namespaceId])
}

model TemplateVersion {
  id              String         @id @default(cuid())
  templateId      String
  version         String
  manifest        Json
  fileKey         String
  status          TemplateStatus @default(DRAFT)
  extends         String?        // base template reference e.g. "@base/starter"
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())

  // Sprint 7: Git source fields
  sourceType      SourceType     @default(ZIP)
  gitUrl          String?
  gitRef          String?
  gitSubPath      String?

  template        Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  skills          TemplateSkill[]

  @@unique([templateId, version])
}

model TemplateSkill {
  id                String          @id @default(cuid())
  templateVersionId String
  skillName         String
  versionRange      String

  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)

  @@unique([templateVersionId, skillName])
}

// ============================================================
// Sprint 7: Git Credential
// ============================================================

model GitCredential {
  id          String          @id @default(uuid())
  name        String
  type        GitAuthType
  url         String
  credential  String          // AES-256-GCM encrypted
  ownerId     String
  scope       CredentialScope @default(PERSONAL)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner       User            @relation(fields: [ownerId], references: [id])

  @@index([url])
}

// ============================================================
// Sprint 8: Download Log
// ============================================================

model DownloadLog {
  id            String         @id @default(uuid())
  userId        String
  resourceType  ResourceType
  resourceId    String
  resourceName  String
  version       String
  source        DownloadSource @default(CLI)
  ip            String?
  userAgent     String?
  createdAt     DateTime       @default(now())

  user          User           @relation(fields: [userId], references: [id])

  @@index([resourceType, resourceId])
  @@index([userId])
  @@index([createdAt])
}

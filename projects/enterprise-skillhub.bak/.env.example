# === Application ===
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# === Database (PostgreSQL) ===
DATABASE_URL=postgresql://skillhub:skillhub_dev@localhost:5432/enterprise_skillhub?schema=public

# === JWT ===
JWT_SECRET=change-me-in-production-use-a-strong-random-string
JWT_EXPIRES_IN=12h

# === LDAP / Active Directory ===
LDAP_URL=ldap://localhost:389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=admin_password
LDAP_SEARCH_BASE=ou=users,dc=example,dc=com
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})

# AD Group → Role mapping (JSON)
LDAP_GROUP_ROLE_MAP={"CN=SkillHub-Admins,OU=Groups,DC=example,DC=com":"ADMIN","CN=SkillHub-Publishers,OU=Groups,DC=example,DC=com":"PUBLISHER","CN=SkillHub-Reviewers,OU=Groups,DC=example,DC=com":"REVIEWER"}

# === MinIO (S3-compatible Object Storage) ===
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=skillhub

# === Redis ===
REDIS_URL=redis://localhost:6379

# === BGE-M3 Embedding Service ===
BGE_M3_URL=http://localhost:8080/v1/encode
BGE_M3_TIMEOUT=5000
BGE_M3_BATCH_SIZE=32

# === Rate Limiting ===
THROTTLE_TTL=60
THROTTLE_LIMIT=60
LOGIN_THROTTLE_TTL=60
LOGIN_THROTTLE_LIMIT=10
